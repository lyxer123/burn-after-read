# Runtime-only image: expects the frontend to be pre-built (frontend/dist).
# Build on the server:  docker build -t onedl -f Dockerfile.runtime .
# (For a full build including the frontend, use the multi-stage ./Dockerfile.)
FROM python:3.12-slim
WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    libjpeg62-turbo libfreetype6 \
    && rm -rf /var/lib/apt/lists/*

COPY backend/requirements.txt ./
# Aliyun PyPI mirror first (fast in CN), fall back to official PyPI
RUN pip install --no-cache-dir -r requirements.txt -i https://mirrors.aliyun.com/pypi/simple/ \
    || pip install --no-cache-dir -r requirements.txt

COPY backend/ ./
COPY web/ ./web

ENV ONEDL_BASE=/data \
    ONEDL_HOST=0.0.0.0 \
    ONEDL_PORT=8777 \
    ONEDL_WEB=/app/web \
    ONEDL_PUBLIC_HOST=http://117.72.15.132

EXPOSE 8777
VOLUME ["/data"]
CMD ["sh", "-c", "uvicorn app:app --host 0.0.0.0 --port 8777"]
